# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Application environment: development | staging | production
ENVIRONMENT=development

# Supabase Postgres connection (async driver required).
# Find this in Supabase: Project Settings -> Database -> Connection string
# (URI). Replace the scheme with postgresql+asyncpg://
# Do NOT leave this as localhost unless you run Postgres locally — login will
# fail with "Database unavailable" / a misleading CORS error in the browser.
# Example: postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL and server-side key for media storage.
# Find these in Supabase: Project Settings -> API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Bucket for uploaded source images.
SUPABASE_MEDIA_BUCKET=media
# Bucket for generated .glb meshes.
SUPABASE_MESH_BUCKET=meshes

# TRELLIS single-image-to-3D on Colab (Gradio). This URL is temporary and
# changes every time the Colab notebook restarts, so update it as needed.
TRELLIS_GRADIO_URL=https://<hash>.gradio.live
# Named Gradio endpoint exposed by the notebook (match your Colab api_name).
TRELLIS_GRADIO_API_NAME=/generate

# Application-owned authentication (NOT Supabase Auth).
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
